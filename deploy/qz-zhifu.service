[Unit]
Description=Quanshi Zhifu application
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/qz-zhifu/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=768
Environment=WRANGLER_WRITE_LOGS=false
Environment=WRANGLER_LOG_PATH=/var/log/qz-zhifu/wrangler.log
ExecStart=/opt/qz-zhifu/current/node_modules/.bin/wrangler dev --config /opt/qz-zhifu/current/dist/server/wrangler.json --ip 127.0.0.1 --port 3001 --persist-to /var/lib/qz-zhifu/wrangler --log-level warn --show-interactive-dev-session false --env-file /opt/qz-zhifu/shared/.env.production
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=1200M
StandardOutput=append:/var/log/qz-zhifu/app.log
StandardError=append:/var/log/qz-zhifu/app.log

[Install]
WantedBy=multi-user.target
